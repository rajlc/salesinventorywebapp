8b87eb90d6b.png","type":"img"},{"itemLevel":false,"poster":"https://static-01.daraz.com.np/p/76c643eb4aae6981230a7b7510ea562f.png","src":"https://static-01.daraz.com.np/p/76c643eb4aae6981230a7b7510ea562f.png","type":"img"}]},"product":{"brand":{"name":"No Brand","suggestion":"More Small Kitchen Appliances from No Brand","suggestionUrl":"https://www.daraz.com.np/small-kitchen-appliances/no-brand-39704/","url":"https://www.daraz.com.np/no-brand-39704/"},"desc":"<article><h1><span></span></h1><p><span></span><img src=\"https://static-01.daraz.com.np/p/82680e7b8041bd1c11c91896d19fcf93.png\" /><span></span></p><p><span></span><img src=\"https://static-01.daraz.com.np/p/e8e19dbd31fd832190522d6031c24a09.jpg\" /><span> </span></p><p><span></span></p><p><span></span><img src=\"https://static-01.daraz.com.np/p/76c643eb4aae6981230a7b7510ea562f.png\" /><span></span></p><p><span></span></p><p><span></span><img src=\"https://static-01.daraz.com.np/p/18ce0319a5edc605ec1549e922031ff7.png\" /><span></span><img src=\"https://static-01.daraz.com.np/p/4daf04cd3eb9d389105078b87eb90d6b.png\" /><span></span><img src=\"https://static-01.daraz.com.np/p/37a896d3c782d8987340e470fb3a7bed.jpg\" /><span> </span><img src=\"https://static-01.daraz.com.np/p/6ddfe84b12ae08c3eabd76daec0db599.jpg\" /><span> </span><img src=\"https://static-01.daraz.com.np/p/8ed51002cff945afd86b8336185d7762.png\" /><span></span></p><p><span></span><img src=\"https://static-01.daraz.com.np/p/a14bfefbf914722af0b9a1d973e2915a.png\" /><span></span><img src=\"https://static-01.daraz.com.np/p/9362caa37c25c3ad4b0f6252a434ba28.png\" /><span></span><img src=\"https://static-01.daraz.com.np/p/1831b3025aca317454cf700ea6769821.jpg\" /><span> </span><img src=\"https://static-01.daraz.com.np/p/50b16f057cfdc5f228eded280a8abff2.jpg\" /><span> </span><img src=\"https://static-01.daraz.com.np/p/d8df499341c6901c0df2e6a5b977b0e1.jpg\" /><span> </span><img src=\"https://static-01.daraz.com.np/p/cee180dd07291ee18ec952347be3ba38.jpg\" /><span> </span><img src=\"https://static-01.daraz.com.np/p/e8e19dbd31fd832190522d6031c24a09.jpg\" /><span> </span></p><ul><li><div><span>【Practical 】The milk frother can be used for milk, matcha, coffee cappuccino / latte macchiato, cocktails, fruit drinks, eggs, soups, dressing, etc. whether at home, in the garden or in the office.</span></div></li><li><div><span>【High quality material 】The material is safe and the food is not easy to glue. Easy to use, clean and store.</span></div></li><li><div><span>【Creamy froth in seconds】There are 2 versatile whisks available: milk frother and egg beater.You can choose the right whisks according to the drink you want.</span></div></li><li><div><span>【3-Speed Adjustable Get Milk Foam Quickly 】at the first speed you can stir the egg liquid to make pudding, at the medium speed you can make baby food supplements, jams, etc. At the highest speed, you can whip cream, protein, etc.</span></div></li><li><div><span>【Eco-friendly USB rechargeable milk frother 】With the milk frother you can charge it anywhere with an environmentally friendly built-in battery via micro USB. The charging process for 6 hours can take 20 to 40 hours depending on the frequency of use. Say goodbye to the tedious task of changing batteries.</span></div></li></ul></article>","highlights":"<article style=\"white-space:break-spaces\" class=\"lzd-article\"><ul><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">यो बिवरण अनुसार अर्डर गर्नु होला २  Milk Frother, मात्रै भएको या Whisk Attachment सहित भएको २ वटै बिकल्प छान्नुहोस् -  कलरहरु धेरै प्रकारको आउछ </span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">मिल्क फ्रोदर हेड (Milk Frother Attachment):</span><span> कफी प्रेमीहरूका लागि यो एउटा बरदान जस्तै हो। यसले दूध वा कफीलाई केही सेकेन्डमै मज्जाले फेटेर बजारको जस्तै बाक्लो र क्रिमी फिँज (Froth) दिन्छ।</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">बलुन विस्क हेड (Balloon Whisk Attachment):</span><span> यदि तपाईंलाई केक बनाउन मनपर्छ वा ओम्लेटको लागि अण्डा फेट्नु छ भने यो हेड एकदमै उपयोगी हुन्छ। यसले थोरै मिहिनेतमै क्रिम र अण्डालाई परफेक्ट टेक्सचरमा ढाल्छ।</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">३-स्पीड कन्ट्रोलर:</span><span> यसमा कम, मध्यम र उच्च गरी ३ वटा गतिको विकल्प छ। कफी र दूधको लागि कम वा मध्यम स्पीड र अण्डा वा बाक्लो क्रिमका लागि उच्च स्पीड प्रयोग गर्न सक्नुहुन्छ।</span></div></li></ul><p style=\"line-height:1.7;text-align:left;text-indent:0;margin-left:0;margin-top:0;margin-bottom:0\"><span style=\"font-weight:bold\">Technical Specifications (प्राविधिक विवरण):</span></p><ul><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">सामाग्री (Material):</span><span> Food-grade Stainless Steel + ABS Plastic</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">चार्जिङ:</span><span> USB Cable (सामेल गरिएको छ)</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">स्पीड लेभल:</span><span> 3 Speeds (Low, Medium, High)</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">रंग:</span><span> Classic Black</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span style=\"font-weight:bold\">उपयोगिता:</span><span> कफी, दूध, अण्डा, क्रिम, लस्सी, प्रोटीन शेक आदि फेट्न।</span></div></li></ul><p style=\"line-height:1.7;text-align:left;text-indent:0;margin-left:0;margin-top:0;margin-bottom:0\"><span style=\"font-weight:bold\">बट्टाभित्र के के पाउनुहुन्छ? (Package Includes):</span></p><ul><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>१ x मुख्य इलेक्ट्रिक ह्यान्डल (Main Handle)</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>१ x मिल्क फ्रोदर हेड (Milk Frother Head)</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>१ x बलुन विस्क हेड (Balloon Whisk Head)</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>१ x USB चार्जिङ केबल</span></div></li></ul></article>","link":"https://www.daraz.com.np/products/milk-frother-handheld-for-coffee-electric-hand-foamer-blender-for-drink-mixer-electric-milk-frother-with-double-whisks-usb-rechargeable-electric-foam-maker-for-coffee-latte-cappuccino-egg-whipping-i512036345-s2295776336.html","rightImgRatio":1.9,"title":"Milk Frother Handheld for Coffee, Electric Hand Foamer Blender for Drink Mixer Electric Milk frother with Double Whisks, USB Rechargeable Electric Foam Maker, for Coffee, Latte, Cappuccino, Egg Whipping"},"globalConfig":{"country":"NP","showTBCBreadCrumb":true,"facebookAppKey":"669323149842984","siteName":"Daraz","pvChecksum":"53732040","reGetDetail":true,"isTBC":false,"voucherListApi":"mtop.lazada.detail.getVouchers","reverseDateMap":{},"viewedSFOUrl":"//pdpdesc-m.daraz.com.np/confirmMsg","host":"lazada-pdp-ns-s033001058238.rg-sg.os30","voucherCollectApi":"mtop.lazada.promotion.voucher.spread","currency":"NPR","robots":"noindex,follow","lang":"en_NP","atmosphereInfo":{"2295776336":{},"12358350775":{}},"isPcRevamp":false,"toastRule":{"voucherPrice":{"duration":3,"hit":true,"intervalHours":24,"stayTime":3}},"env":"new env","showSKUSelect":false,"site":"NP","isAPPLE":false,"mdsMap":{"shareTitle":"Share","likeTitle":"Like"},"recommendParameter":"category_id=5905&item_id=512036345&regional_key=050602090000&sku=512036345_NP-2295776336&seller_id=900220480533&is_tbc=0&_=1785398074193&brand_id=39704","showHTBTips":false,"voucherListParams":"timeStamp=1785398074193&itemId=512036345&lzd=3E7145340439C03C216942296827AF8623BF1A9C9E587730A6A38C371060C269B069B25771B9633F07E38115F964DD08F3EACFA36FA2D95BECE0DFA41F57850F12431D959984CB88F1F885B091