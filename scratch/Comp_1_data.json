ttps://static-01.daraz.com.np/p/1a97ad919971e6aa97101a4c0cd3436a.png","type":"img"},{"itemLevel":true,"poster":"https://static-01.daraz.com.np/p/36a475fa761c042d6755b72b954720ac.png","src":"https://static-01.daraz.com.np/p/36a475fa761c042d6755b72b954720ac.png","type":"img"},{"itemLevel":false,"poster":"https://static-01.daraz.com.np/p/1700a5bf31eb6b1bcc1d55a698709820.jpg","src":"https://static-01.daraz.com.np/p/1700a5bf31eb6b1bcc1d55a698709820.jpg","type":"img"}]},"product":{"brand":{"name":"No Brand","suggestion":"More Coffee & Tea from No Brand","suggestionUrl":"https://www.daraz.com.np/coffee-tea-kitchenware/no-brand-39704/","url":"https://www.daraz.com.np/no-brand-39704/"},"highlights":"<article style=\"white-space:break-spaces\" class=\"lzd-article\"><ul style=\"list-style-type:disc\"><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Color: Multicolour (Black, Green, Pink)</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Material: Stainless Steel Whisk &amp; ABS Plastic Handle</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Quick Frothing: Froths milk in just 15-20 seconds, perfect for busy mornings.</span></div></li></ul><ul style=\"list-style-type:disc\"><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Powerful Motor: The electric motor delivers smooth and consistent froth every time.</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Ergonomic Design: Lightweight and comfortable grip for easy use.</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Durable Stainless Steel Whisk: Long-lasting and easy to clean.</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Compact and Portable: Convenient size, perfect for travel or home use.</span></div></li></ul><ul style=\"list-style-type:disc\"><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Rechargeable Battery: Rechargeable lithium battery eliminates the need for additional batteries, saving you money. Easily rechargeable via an included Android USB cable in just 6 hours.</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Adjustable Speeds: Blue light indicator with multiple speed settings (low, medium, high) for the perfect frother effect. Choose your desired speed for different beverages.</span></div></li><li><div style=\"line-height:1.7;text-align:left;text-indent:0\"><span>Versatile Usage: Ideal for making foam for various beverages including coffee, all types of milks, cream, cappuccinos, matcha lattes, and hot chocolate with ease.</span></div></li></ul></article>","link":"https://www.daraz.com.np/products/milk-frother-handheld-for-coffee-electric-hand-foamer-blender-for-drink-mixer-i512414330-s2303162709.html","rightImgRatio":1.9,"title":"Milk Frother Handheld for Coffee, Electric Hand Foamer Blender for Drink Mixer"},"globalConfig":{"country":"NP","showTBCBreadCrumb":true,"facebookAppKey":"669323149842984","siteName":"Daraz","pvChecksum":"53732040","reGetDetail":true,"isTBC":false,"voucherListApi":"mtop.lazada.detail.getVouchers","reverseDateMap":{},"viewedSFOUrl":"//pdpdesc-m.daraz.com.np/confirmMsg","host":"lazada-pdp-ns-s033002225006.sg52","voucherCollectApi":"mtop.lazada.promotion.voucher.spread","currency":"NPR","robots":"noindex,follow","lang":"en_NP","atmosphereInfo":{"2303162707":{},"2303162708":{},"2303162709":{}},"isPcRevamp":false,"toastRule":{"voucherPrice":{"duration":3,"hit":true,"intervalHours":24,"stayTime":3}},"env":"new env","showSKUSelect":false,"site":"NP","isAPPLE":false,"mdsMap":{"shareTitle":"Share","likeTitle":"Like"},"recommendParameter":"category_id=10000597&item_id=512414330&regional_key=240605000000&sku=512414330_NP-2303162709&seller_id=900316640006&is_tbc=0&_=1785398073614&brand_id=39704","showHTBTips":false,"voucherListParams":"timeStamp=1785398073614&i